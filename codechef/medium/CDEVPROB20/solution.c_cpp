#include <stdio.h>

int main() {
    // Declare a float variable for the radius and initialize it with 5.345
    float r=5.345000;
    // Declare a double variable for the area and initialize it with 89.752232
    double a=89.752232;

    // Print the radius of the circle
    printf("Radius: %f\n",r);

    // Print the area of the circle
    printf("Area: %lf\n",a);


    return 0;
}
